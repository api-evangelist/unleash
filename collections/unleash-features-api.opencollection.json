        {
          "info": {
            "name": "Move Feature to Project",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.unleash-instance.example.com/api/admin/projects/:projectId/features/:featureName/changeProject",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              },
              {
                "name": "featureName",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "**Enterprise feature**\n\nMoves the specified feature to the new project in the request schema. Requires you to have permissions to move the feature flag in both projects. Features that are included in any active change requests can not be moved."
        },
        {
          "info": {
            "name": "Validate a Feature Flag Name.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.unleash-instance.example.com/api/admin/features/validate",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Validates a feature flag name: checks whether the name is URL-friendly and whether a feature with the given name already exists. Returns 200 if the feature name is compliant and unused."
        },
        {
          "info": {
            "name": "Get All Tags for a Feature.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.unleash-instance.example.com/api/admin/features/:featureName/tags",
            "params": [
              {
                "name": "featureName",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieves all the tags for a feature name. If the feature does not exist it returns an empty list."
        },
        {
          "info": {
            "name": "Adds a Tag to a Feature.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.unleash-instance.example.com/api/admin/features/:featureName/tags",
            "params": [
              {
                "name": "featureName",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Adds a tag to a feature if the feature and tag type exist in the system. The operation is idempotent, so adding an existing tag will result in a successful response."
        },
        {
          "info": {
            "name": "Updates Multiple Tags for a Feature.",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://app.unleash-instance.example.com/api/admin/features/:featureName/tags",
            "params": [
              {
                "name": "featureName",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Receives a list of tags to add and a list of tags to remove that are mandatory but can be empty. All tags under addedTags are first added to the feature and then all tags under removedTags are removed from the feature."
        },
        {
          "info": {
            "name": "Removes a Tag From a Feature.",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
