        {
          "info": {
            "name": "Get All Release Templates.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.unleash-instance.example.com/api/admin/release-plan-templates"
          },
          "docs": "**Enterprise feature**\n\nReturns a list of all release templates."
        },
        {
          "info": {
            "name": "Create a Release Template.",
            "type": "http"
          },
          "http": {
            "method": "POST",
