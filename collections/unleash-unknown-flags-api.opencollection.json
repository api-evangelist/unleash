{
  "opencollection": "1.0.0",
  "info": {
    "name": "Unleash Admin Addons Unknown Flags API",
    "version": "7.4.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Unknown Flags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Unknown Flags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.unleash-instance.example.com/api/admin/metrics/unknown-flags"
          },
          "docs": "Returns a list of unknown flag reports from the last 24 hours, if any. Maximum of 1000."
        }
      ]
    }
  ],
  "bundled": true
}