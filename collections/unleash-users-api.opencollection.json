          "http": {
            "method": "PUT",
            "url": "https://app.unleash-instance.example.com/api/admin/user-admin/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "a user id"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Only the explicitly specified fields get updated."
        },
        {
          "info": {
            "name": "Delete a User",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.unleash-instance.example.com/api/admin/user-admin/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
