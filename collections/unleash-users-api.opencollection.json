          "docs": "Get a total count of admins with password, without password and admin service accounts"
        },
        {
          "info": {
            "name": "Get User",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.unleash-instance.example.com/api/admin/user-admin/:id",
